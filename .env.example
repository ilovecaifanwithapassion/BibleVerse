# =============================================================================
# BIBLE STUDY WEBSITE - ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port
PORT=3000

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Sign up at https://supabase.com to create a new project.
# Copy your Project URL and Anon (Public) Key from Project Settings > API.
# WARNING: NEVER expose your SUPABASE_SERVICE_ROLE_KEY in frontend code!
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# -----------------------------------------------------------------------------
# SCRIPTURE DATA PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
# Options:
# 1. "github"     - Fetches NIV JSON from github.com/aruljohn/Bible-niv
# 2. "api_bible"  - Connects to API.Bible (requires authorized API key for licensed NIV)
# 3. "custom_api" - Connects to your organization's authorized Scripture endpoint
# -----------------------------------------------------------------------------
SCRIPTURE_PROVIDER=github
SCRIPTURE_CACHE_ENABLED=true

# API.Bible settings (if SCRIPTURE_PROVIDER=api_bible)
API_BIBLE_KEY=your_api_bible_key_here
API_BIBLE_BIBLE_ID=your_authorized_niv_bible_id
